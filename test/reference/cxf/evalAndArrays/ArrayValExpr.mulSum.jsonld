      ],
      "S231:icon": "graphics={Rectangle(extent={{-100,-100},{100,100}},lineColor={0,0,127},fillColor={255,255,255},fillPattern=FillPattern.Solid),Text(textString=\"%k\",textColor={0,0,0},extent={{-200,-110},{200,-140}}),Text(textString=\"+\",textColor={0,0,0},extent={{-82,90},{82,-46}}),Text(textString=\"%name\",textColor={0,0,255},extent={{-144,150},{156,110}}),Text(textString=DynamicSelect(\"\",String(y,leftJustified=false,significantDigits=3)),textColor={0,0,0},extent={{226,60},{106,10}})}",
